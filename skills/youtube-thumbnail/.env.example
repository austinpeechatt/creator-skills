# Google AI Studio key — https://aistudio.google.com/apikey
# Used for Gemini image generation. Renders cost roughly 4 cents each.
GEMINI_API_KEY=your_key_here

# OPTIONAL. Only needed for search_examples.py, which pulls high-performing
# thumbnails in your niche to use as style references. The skill works fine
# without it — just omit the --examples flag.
SCRAPECREATORS_API_KEY=
