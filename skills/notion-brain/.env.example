# Notion integration token — https://www.notion.so/my-integrations
# Create an internal integration, then SHARE your database with it (Notion
# integrations only see pages explicitly shared with them).
NOTION_API_KEY=ntn_your_token_here

# The database that holds your video ideas.
# Open the DB as a full page; the ID is the 32-char string in the URL.
NOTION_YOUTUBE_DB_ID=00000000000000000000000000000000
