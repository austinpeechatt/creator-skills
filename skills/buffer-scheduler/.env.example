# Buffer API access token and org.
# These come from an authenticated Buffer session — this tooling talks to
# Buffer's GraphQL API, not the public REST API.
BUFFER_PB_TOKEN=your_token_here
BUFFER_PB_ORG=your_org_id_here

# Channel IDs, one per connected account. Omit any you don't use.
BUFFER_PB_YOUTUBE=
BUFFER_PB_INSTAGRAM=
BUFFER_PB_TIKTOK=

# OPTIONAL. Path to a separate env file holding TELEGRAM_BOT_TOKEN and
# ALLOWED_USER_ID, used by health_check.js to alert on failed posts.
# TELEGRAM_ENV_PATH=/path/to/telegram.env
