# Where you cloned open-carrusel — https://github.com/FrancescoXX/open-carrusel
# This skill authors HTML and seeds it into that app; the app does the rendering
# and PNG export. Nothing in the workflow runs without it.
OPEN_CARRUSEL_DIR=/path/to/open-carrusel

# ---- Phase 2, posting (optional) -------------------------------------------
# Only needed if you want to push finished slides straight to Buffer. Generating
# and exporting carousels works without any of this.
#
# READ FIRST: the image-upload path in scripts/post_to_buffer.js targets
# catbox.moe, which Buffer started rejecting in July 2026. Buffer also re-fetches
# media at PUBLISH time, not when you schedule — so a temporary host will fail
# quietly days later. Point upload() at permanent hosting you control first.

BUFFER_ACCESS_TOKEN=your_buffer_token_here

# Buffer channel ids. Most accounts have several — confirm you grabbed the one
# you mean before scheduling anything outward.
BUFFER_IG_CHANNEL=000000000000000000000000
BUFFER_LINKEDIN_CHANNEL=000000000000000000000000

# ---- Notion source (optional) ----------------------------------------------
# Only if you want to build a carousel from a YouTube-summary database rather
# than from a topic you type in. Notion integrations only see pages you
# explicitly SHARE with them — that's the usual setup failure.
NOTION_API_KEY=ntn_your_token_here
NOTION_SUMMARIES_DB_ID=00000000000000000000000000000000
